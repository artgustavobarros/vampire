{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": ["**/src/**/*", "**/test/**/*", "*.ts", "!**/drizzle"]
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noParameterProperties": "off",
        "useImportType": "off"
      }
    }
  }
}
