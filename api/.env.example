# Porta HTTP da API
PORT=3333

# Mesmo usuário/senha/banco do serviço `db` do docker-compose.yml
DATABASE_URL=postgres://vampire:vampire@localhost:5432/vampire

# Troque em produção: pelo menos 32 caracteres (ex.: openssl rand -base64 48)
JWT_SECRET=dev-secret-troque-isto-antes-de-usar-de-verdade
JWT_EXPIRES_IN=7d

# Origens do web liberadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:3000

# Conta do Mestre (role dm), criada ou atualizada pela API ao subir. Defina as
# duas ou nenhuma; trocar a senha aqui troca a senha da conta.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=!@#ASD123asd
