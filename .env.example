# Variáveis do docker-compose.yml (copie para .env). Para rodar a API fora do
# Docker, use api/.env.example. As de produção (docker-compose.prod.yml:
# APP_HOST, JWT_SECRET, POSTGRES_PASSWORD, ADMIN_EMAIL, ADMIN_PASSWORD) ficam
# nos secrets e variables do GitHub; veja "Deploy (Hostinger)" no README.

# Portas publicadas no host
DB_PORT=5432
API_PORT=3333
WEB_PORT=3000

# Troque em produção: pelo menos 32 caracteres (ex.: openssl rand -base64 48)
JWT_SECRET=dev-secret-troque-isto-antes-de-usar-de-verdade
JWT_EXPIRES_IN=7d

# Conta do Mestre de desenvolvimento (padrão: admin@admin.com / !@#ASD123asd)
# ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=!@#ASD123asd

# Opcionais: por padrão derivam das portas acima
# CORS_ORIGIN=http://localhost:3000
# VITE_API_URL=http://localhost:3333/api
